# VentaSync — project-root .htaccess
#
# Pairs with the index.php shim at the project root so customers can drop
# the entire codebase into a shared-hosting document root (cPanel, HestiaCP,
# CyberPanel, Plesk) without changing DocumentRoot to public/.
#
# Two jobs:
#   1. Forbid direct access to application code paths and dotfiles, so the
#      security boundary that public/ would normally provide is preserved.
#   2. For requests that map to a real file inside public/, rewrite the URL
#      to serve that file. Everything else falls through to index.php (the
#      shim), which loads Laravel.

<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes
    RewriteEngine On

    # ── 1. Block direct access to application code + dotfiles ─────────────

    # Any URI starting with a dot (.env, .git, .htaccess, etc.)
    RewriteRule "(?i)(^|/)\." - [F,L]

    # Top-level application directories that must never be web-readable
    RewriteRule ^(app|bootstrap|config|database|extensions|opencart_extensions|resources|routes|storage|tests|vendor)(/|$) - [F,L]

    # composer.json/lock and other manifests
    RewriteRule ^(composer\.(json|lock)|package\.json|package-lock\.json|artisan|phpunit\.xml(\.dist)?|README\.md|LICENSE|UPGRADE\.md|INSTALL\.md)$ - [F,L]

    # ── 2. Rewrite to public/ for real files, otherwise to index.php ──────

    # If the requested path is a real file inside public/, serve it from there.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L]

    # All other requests hit the bootstrap shim, which loads public/index.php.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
